# Match 설정 - 인증서/프로비저닝 프로파일 관리

git_url("https://github.com/thingineeer/fastlane-match-runnect")
git_branch("master")
storage_mode("git")

type("appstore") # development, adhoc, appstore, enterprise

# 모든 타겟의 Bundle ID
app_identifier([
  "com.runnect.Runnect-iOS",
  "com.runnect.Runnect-iOS.watchkitapp"
])

username(ENV["APPLE_ID"])
team_id(ENV["TEAM_ID"])

# Keychain 설정 (CI 환경용)
keychain_name(ENV["MATCH_KEYCHAIN_NAME"] || "login.keychain")
keychain_password(ENV["MATCH_KEYCHAIN_PASSWORD"])

# 읽기 전용 모드 (CI에서는 true 권장)
readonly(true)
