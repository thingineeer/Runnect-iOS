default_platform(:ios)

platform :ios do

  ############# API Key #############

  desc "App Store Connect API Key 인증"
  private_lane :api_key do
    app_store_connect_api_key(
      key_id: "KX2PB582GG",
      issuer_id: "e5ea7eb2-038f-46e0-91c7-719bb0c07b2e",
      key_filepath: File.expand_path("~/Desktop/AuthKey_KX2PB582GG.p8")
    )
  end

  ############# Version #############

  desc "Set Marketing and Build version"
  lane :set_version do |options|
    increment_version_number(
      version_number: options[:version],
      xcodeproj: "./Runnect-iOS.xcodeproj"
    )

    increment_build_number(
      build_number: Time.new.strftime("%Y.%m%d.%H%M"),
      xcodeproj: "./Runnect-iOS.xcodeproj"
    )
  end

  ############# App Store Release #############

  desc "Build app and release to App Store Review"
  desc "Usage: fastlane release version:2.3.0"
  lane :release do |options|
    start_time = Time.now
    version = options[:version]

    # API 키 인증
    api_key_data = api_key

    # 코드 서명: 자동 프로비저닝 (로컬 인증서 사용)
    update_code_signing_settings(
      use_automatic_signing: true,
      path: "./Runnect-iOS.xcodeproj",
      team_id: "8Q4H7X3Q58"
    )

    # 버전 설정
    if version
      puts "버전 정보: #{version}"
      set_version(version: version)
    else
      puts "버전 입력 X - 빌드 넘버만 증가"
      increment_build_number(
        build_number: Time.new.strftime("%Y.%m%d.%H%M"),
        xcodeproj: "./Runnect-iOS.xcodeproj"
      )
    end

    # 빌드
    build_app(
      workspace: "Runnect-iOS.xcworkspace",
      scheme: "Runnect-iOS",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_xcargs: "-allowProvisioningUpdates"
    )

    # App Store 업로드 + 심사 제출
    upload_to_app_store(
      api_key: api_key_data,
      app_version: version,
      submit_for_review: false,
      force: true,
      automatic_release: false,
      skip_screenshots: true,
      skip_metadata: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: true,
        add_id_info_serves_ads: true,
        add_id_info_tracks_action: true,
        add_id_info_tracks_install: true
      }
    )

    end_time = Time.now
    elapsed_time = ((end_time - start_time) / 60).round(2)
    puts "App Store 심사 제출 완료! #{elapsed_time}분 소요"
  end

  ############# Submit for Review #############

  desc "Submit existing build for App Store Review"
  desc "Usage: fastlane submit_review version:2.4.1"
  lane :submit_review do |options|
    api_key_data = api_key
    version = options[:version]

    upload_to_app_store(
      api_key: api_key_data,
      app_version: version,
      submit_for_review: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      force: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: true,
        add_id_info_serves_ads: true,
        add_id_info_tracks_action: true,
        add_id_info_tracks_install: true
      }
    )

    puts "App Store 심사 제출 완료!"
  end

  ############# TestFlight #############

  desc "Push a new beta build to TestFlight"
  desc "Usage: fastlane beta version:2.3.0"
  lane :beta do |options|
    start_time = Time.now
    version = options[:version]

    api_key_data = api_key

    match(
      type: "appstore",
      app_identifier: ["com.runnect.Runnect-iOS", "com.runnect.Runnect-iOS.watchkitapp"],
      readonly: false,
      api_key: api_key_data
    )

    if version
      puts "버전 정보: #{version}"
      set_version(version: version)
    else
      increment_build_number(
        build_number: Time.new.strftime("%Y.%m%d.%H%M"),
        xcodeproj: "./Runnect-iOS.xcodeproj"
      )
    end

    build_app(
      workspace: "Runnect-iOS.xcworkspace",
      scheme: "Runnect-iOS",
      configuration: "Release",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key_data,
      skip_waiting_for_build_processing: true
    )

    end_time = Time.now
    elapsed_time = ((end_time - start_time) / 60).round(2)
    puts "TestFlight 배포 완료! #{elapsed_time}분 소요"
  end

  ############# Metadata Only #############

  desc "Upload metadata only (no binary)"
  desc "Usage: fastlane update_metadata version:2.3.0"
  lane :update_metadata do |options|
    api_key_data = api_key
    version = options[:version]

    upload_to_app_store(
      api_key: api_key_data,
      app_version: version,
      reject_if_possible: true,
      submit_for_review: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      force: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: true,
        add_id_info_serves_ads: true,
        add_id_info_tracks_action: true,
        add_id_info_tracks_install: true
      }
    )

    puts "메타데이터 업데이트 완료!"
  end

  desc "Download current metadata from App Store Connect"
  lane :download_metadata do
    api_key_data = api_key

    deliver(
      api_key: api_key_data,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      force: true,
      run_precheck_before_submit: false
    )
  end

  ############# Device Management #############

  desc "Register Devices"
  lane :register_new_device do
    api_key_data = api_key
    device_name = prompt(text: "Enter the device name: ")
    device_udid = prompt(text: "Enter the device UDID: ")
    device_hash = {}
    device_hash[device_name] = device_udid
    register_devices(devices: device_hash, api_key: api_key_data)
    match(type: "development", force_for_new_devices: true, api_key: api_key_data)
  end

  ############# Match #############

  desc "Match all code signing (read only)"
  lane :match_read_only do
    api_key_data = api_key

    match(
      type: "appstore",
      app_identifier: "com.runnect.Runnect-iOS",
      readonly: true,
      api_key: api_key_data
    )

    match(
      type: "development",
      app_identifier: "com.runnect.Runnect-iOS",
      readonly: true,
      api_key: api_key_data
    )
  end

  ############# Watch Provisioning #############

  desc "Upload IPA to App Store Connect (without review)"
  lane :upload_only do |options|
    api_key_data = api_key
    version = options[:version]

    upload_to_app_store(
      api_key: api_key_data,
      ipa: options[:ipa] || "/tmp/ipa_export/Runnect-iOS.ipa",
      app_version: version,
      submit_for_review: false,
      force: true,
      automatic_release: false,
      skip_screenshots: true,
      skip_metadata: false,
      precheck_include_in_app_purchases: false
    )
  end

  ############# Error Handling #############

  error do |lane, exception, options|
    puts "Error in lane '#{lane}': #{exception.message}"
  end
end
